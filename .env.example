# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Google AI Studio (Gemini Multi-Agent Pipeline)
GEMINI_API_KEY=your-gemini-api-key-from-aistudio-google-com

# ISR On-Demand Revalidation Token (for n8n webhook)
REVALIDATION_SECRET_TOKEN=generate-a-secure-random-token-here

# Site Info
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=PromptGrid AI
NEXT_PUBLIC_PRODUCTION_URL=https://promptgridai.com

# Monetization (Later)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Social Media Links (Instagram, Facebook, YouTube)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/your-handle
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/your-page
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/@your-channel
